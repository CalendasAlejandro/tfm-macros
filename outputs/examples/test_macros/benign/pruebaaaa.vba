'INICIO VALIDACIï¿½N PRODUCTO-CULTIVO;;;;;;
Sub ValidarCultivosConFacturado();;;;;;
;;;;;;
    Dim wsReparto As Worksheet;;;;;;
    Dim wsFacturado As Worksheet;;;;;;
    ;;;;;;
    Dim ultimaFilaReparto As Long;;;;;;
    Dim ultimaFilaFacturado As Long;;;;;;
    ;;;;;;
    Dim i As Long;;;;;;
    Dim cultivosReparto As String;;;;;;
    Dim arrCultivosReparto As Variant;;;;;;
    Dim cultivoItem As String;;;;;;
    Dim numRegistro As String;;;;;;
    ;;;;;;
    Dim encontrado As Boolean;;;;;;
    Dim hayErrores As Boolean;;;;;;
    ;;;;;;
    Dim dictFacturado As Object;;;;;;
    Dim dictCultivosFacturado As Object;;;;;;
    ;;;;;;
    ' Configurar hojas;;;;;;
"    Set wsReparto = ThisWorkbook.Sheets(""""REPARTO"""")";;;;;;
"    Set wsFacturado = ThisWorkbook.Sheets(""""FACTURADO"""")";;;;;;
    ;;;;;;
    ' ï¿½ltimas filas - CAMBIADO: columna R por Q;;;;;;
"    ultimaFilaReparto = wsReparto.Cells(wsReparto.Rows.Count, """"Q"""").End(xlUp).Row";;;;;;
"    ultimaFilaFacturado = wsFacturado.Cells(wsFacturado.Rows.Count, """"G"""").End(xlUp).Row";;;;;;
    ;;;;;;
    ' ========== CARGAR DICCIONARIO FACTURADO ==========;;;;;;
"    Set dictFacturado = CreateObject(""""Scripting.Dictionary"""")";;;;;;
    dictFacturado.CompareMode = vbTextCompare;;;;;;
    ;;;;;;
    For i = 2 To ultimaFilaFacturado;;;;;;
        Dim producto As String;;;;;;
"        producto = LimpiarTexto(wsFacturado.Cells(i, """"G"""").value)";;;;;;
        If Len(producto) > 0 Then;;;;;;
            If Not dictFacturado.Exists(producto) Then;;;;;;
"                dictFacturado.Add producto, wsFacturado.Cells(i, """"O"""").value";;;;;;
            End If;;;;;;
        End If;;;;;;
    Next i;;;;;;
    ;;;;;;
    ' Diccionario anidado de cultivos autorizados;;;;;;
"    Set dictCultivosFacturado = CreateObject(""""Scripting.Dictionary"""")";;;;;;
    dictCultivosFacturado.CompareMode = vbTextCompare;;;;;;
    ;;;;;;
    Dim prodKey As Variant;;;;;;
    For Each prodKey In dictFacturado.keys;;;;;;
        Dim cultivosStr As String;;;;;;
        Dim arrCultivos As Variant;;;;;;
        Dim cultDict As Object;;;;;;
        Dim idx As Long;;;;;;
        ;;;;;;
        cultivosStr = dictFacturado(prodKey);;;;;;
"        cultivosStr = Replace(cultivosStr, """" ";", """"";);;;;
"        cultivosStr = Replace(cultivosStr, """"";" """", """"";);;;;
"        arrCultivos = Split(cultivosStr, """"";);;;;;
        ;;;;;;
"        Set cultDict = CreateObject(""""Scripting.Dictionary"""")";;;;;;
        cultDict.CompareMode = vbTextCompare;;;;;;
        ;;;;;;
        For idx = LBound(arrCultivos) To UBound(arrCultivos);;;;;;
            Dim cultLimpio As String;;;;;;
            cultLimpio = LimpiarTexto(arrCultivos(idx));;;;;;
            If Len(cultLimpio) > 0 Then;;;;;;
                cultDict(cultLimpio) = True;;;;;;
            End If;;;;;;
        Next idx;;;;;;
        ;;;;;;
        Set dictCultivosFacturado(prodKey) = cultDict;;;;;;
    Next prodKey;;;;;;
    ;;;;;;
    ' ========== PROCESAR REPARTO ==========;;;;;;
    hayErrores = False;;;;;;
    ;;;;;;
    ' Limpiar colores - CAMBIADO: columna R por Q;;;;;;
"    wsReparto.Range(""""Q5:Q"""" & ultimaFilaReparto).Interior.ColorIndex = xlNone";;;;;;
    ;;;;;;
    Application.ScreenUpdating = False;;;;;;
    Application.Calculation = xlCalculationManual;;;;;;
    ;;;;;;
    For i = 5 To ultimaFilaReparto;;;;;;
        ' CAMBIADO: columna R por Q;;;;;;
"        cultivosReparto = wsReparto.Cells(i, """"Q"""").value";;;;;;
"        numRegistro = LimpiarTexto(wsReparto.Cells(i, """"O"""").value)";;;;;;
        ;;;;;;
        encontrado = False;;;;;;
        ;;;;;;
        If Len(cultivosReparto) > 0 And Len(numRegistro) > 0 Then;;;;;;
            If dictCultivosFacturado.Exists(numRegistro) Then;;;;;;
                Dim cultivosAutorizados As Object;;;;;;
                Set cultivosAutorizados = dictCultivosFacturado(numRegistro);;;;;;
                ;;;;;;
                ' Limpiar y dividir cultivos de REPARTO;;;;;;
                Dim cultivosTemp As String;;;;;;
                cultivosTemp = cultivosReparto;;;;;;
"                cultivosTemp = Replace(cultivosTemp, """" ";", """"";);;;;
"                cultivosTemp = Replace(cultivosTemp, """"";" """", """"";);;;;
"                arrCultivosReparto = Split(cultivosTemp, """"";);;;;;
                ;;;;;;
                Dim k As Long;;;;;;
                For k = LBound(arrCultivosReparto) To UBound(arrCultivosReparto);;;;;;
                    cultivoItem = LimpiarTexto(arrCultivosReparto(k));;;;;;
                    If Len(cultivoItem) > 0 Then;;;;;;
                        If cultivosAutorizados.Exists(cultivoItem) Then;;;;;;
                            encontrado = True;;;;;;
                            Exit For;;;;;;
                        End If;;;;;;
                    End If;;;;;;
                Next k;;;;;;
            End If;;;;;;
        End If;;;;;;
        ;;;;;;
        ' CAMBIADO: columna R por Q;;;;;;
        If encontrado Then;;;;;;
"            wsReparto.Cells(i, """"Q"""").Interior.Pattern = xlNone";;;;;;
        Else;;;;;;
"            wsReparto.Cells(i, """"Q"""").Interior.Color = RGB(255, 0, 0)";;;;;;
            hayErrores = True;;;;;;
        End If;;;;;;
    Next i;;;;;;
    ;;;;;;
    Application.ScreenUpdating = True;;;;;;
    Application.Calculation = xlCalculationAutomatic;;;;;;
    ;;;;;;
    If hayErrores Then;;;;;;
"        MsgBox """"Se encontraron productos no autorizados para esos cultivos. Cambiar el cultivo o el producto."""", vbExclamation";;;;;;
    Else;;;;;;
"        MsgBox """"Validaciï¿½n completada. Todos los productos estï¿½n autorizados para esos cultivos."""", vbInformation";;;;;;
    End If;;;;;;
;;;;;;
End Sub;;;;;;
;;;;;;
;;;;;;
Private Function LimpiarTexto(ByVal v As Variant) As String;;;;;;
;;;;;;
    Dim s As String;;;;;;
    ;;;;;;
    If IsNull(v) Or IsEmpty(v) Then;;;;;;
"        LimpiarTexto = """"""""";;;;;;
        Exit Function;;;;;;
    End If;;;;;;
    ;;;;;;
    s = CStr(v);;;;;;
"    s = Replace(s, vbCr, """" """")";;;;;;
"    s = Replace(s, vbLf, """" """")";;;;;;
    s = Trim$(s);;;;;;
    ;;;;;;
"    Do While InStr(s, """"  """") > 0";;;;;;
"        s = Replace(s, """"  """", """" """")";;;;;;
    Loop;;;;;;
    ;;;;;;
    LimpiarTexto = s;;;;;;
;;;;;;
End Function;;;;;;
;;;;;;
'FIN VALIDACIï¿½N PRODUCTO-CULTIVO;;;;;;
